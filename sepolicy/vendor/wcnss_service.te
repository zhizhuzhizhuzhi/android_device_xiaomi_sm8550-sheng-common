# nv_mac derives factory addresses from two vendor inputs and writes only its
# dedicated /data/vendor/mac_addr output. Generic persist, modem and user-media
# write access is not needed for this shipped binary's path inventory.
allow vendor_wcnss_service self:capability { net_raw setgid setuid };
allow vendor_wcnss_service self:packet_socket write;
allow vendor_wcnss_service sysfs_net:file read;
allow vendor_wcnss_service vendor_mac_vendor_data_file:dir create_dir_perms;
allow vendor_wcnss_service vendor_mac_vendor_data_file:file create_file_perms;
r_dir_file(vendor_wcnss_service, vendor_sheng_wifi_factory_file)
allow vendor_wcnss_service vendor_persist_bluetooth_file:dir search;
allow vendor_wcnss_service vendor_persist_bluetooth_file:file r_file_perms;
